type: HeatCrafter
name: Peroxate Refinery
description: It electrifies and heats the mycelial exudate to extremely high temperatures in order to purify it, transforming it into peroxate, a substance so energetic that it corrodes most materials.
size: 4
heatRequirement: 35
liquidCapacity: 30
craftTime: 600
squareSprite: false
hasPower: true
consumes: {
  liquids: [
  ev-liq-04-mycelial-exudate/0.1
  ]
  power: 13
}

ignoreLiquidFullness: true

ambientSound: loopMachineSpin
ambientSoundVolume: 0.09

